---
import type { ProfileHighlight } from '../data/profile';

type Props = {
  highlights: ProfileHighlight[];
};

const { highlights } = Astro.props;
---

<section class="highlight-showcase" aria-label="职业高光">
  {
    highlights.map((item) => (
      <article class="highlight-slide" data-highlight-slide>
        <div class="highlight-slide__inner">
          <div class="highlight-slide__main">
            <h3 class="highlight-slide__title">{item.title}</h3>
            <p class="highlight-slide__summary">{item.summary}</p>
            <a class="highlight-slide__cta btn" href={`/work/${item.slug}#results`}>
              View Details
              <span class="highlight-slide__cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="highlight-slide__metric-wrap">
            <p class="highlight-slide__metric">
              {
                item.metric.value != null ? (
                  <span
                    class="highlight-slide__metric-value"
                    data-count-value={item.metric.value}
                    data-count-prefix={item.metric.prefix ?? ''}
                    data-count-suffix={item.metric.suffix ?? ''}
                    data-count-decimals={item.metric.decimals ?? 0}
                  >
                    {item.metric.prefix ?? ''}0{item.metric.suffix ?? ''}
                  </span>
                ) : (
                  <span class="highlight-slide__metric-value highlight-slide__metric-value--static">
                    {item.metric.displayValue}
                  </span>
                )
              }
            </p>
            <p class="highlight-slide__metric-label">{item.metric.label}</p>
          </div>
        </div>
      </article>
    ))
  }
</section>

<style>
  .highlight-showcase {
    margin-top: 0.5rem;
  }

  .highlight-slide {
    display: flex;
    align-items: center;
    min-height: min(42vh, 320px);
    padding: 1.75rem 0;
  }

  .highlight-slide + .highlight-slide {
    border-top: 1px solid var(--border);
  }

  .highlight-slide__inner {
    display: grid;
    grid-template-columns: 1fr minmax(9rem, 34%);
    gap: 1.5rem 2.5rem;
    align-items: center;
    width: 100%;
  }

  .highlight-slide__title,
  .highlight-slide__summary,
  .highlight-slide__cta,
  .highlight-slide__metric-wrap {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .highlight-slide.is-active .highlight-slide__title {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0ms;
  }

  .highlight-slide.is-active .highlight-slide__metric-wrap {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 100ms;
  }

  .highlight-slide.is-active .highlight-slide__summary {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 200ms;
  }

  .highlight-slide.is-active .highlight-slide__cta {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 280ms;
  }

  .highlight-slide__title {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .highlight-slide__metric-wrap {
    text-align: right;
    justify-self: end;
  }

  .highlight-slide__metric {
    margin: 0;
    line-height: 1;
  }

  .highlight-slide__metric-value {
    font-size: clamp(2.25rem, 5.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .highlight-slide__metric-value--static {
    font-size: clamp(1.75rem, 4vw, 2.35rem);
  }

  .highlight-slide__metric-label {
    margin: 0.5rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .highlight-slide__summary {
    margin: 0.65rem 0 0;
    max-width: 34rem;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .highlight-slide__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    text-decoration: none;
  }

  .highlight-slide__cta-arrow {
    transition: transform 0.15s ease;
  }

  .highlight-slide__cta:hover .highlight-slide__cta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .highlight-slide {
      min-height: auto;
      padding: 1.35rem 0;
    }

    .highlight-slide__inner {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .highlight-slide__metric-wrap {
      text-align: left;
      justify-self: start;
      order: -1;
      padding-bottom: 0.25rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0.25rem;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .highlight-slide__title,
    .highlight-slide__summary,
    .highlight-slide__cta,
    .highlight-slide__metric-wrap {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function easeOutCubic(t: number) {
    return 1 - Math.pow(1 - t, 3);
  }

  function formatCount(value: number, decimals: number, prefix: string, suffix: string) {
    const num = decimals > 0 ? value.toFixed(decimals) : String(Math.round(value));
    return `${prefix}${num}${suffix}`;
  }

  function animateCount(
    el: HTMLElement,
    target: number,
    duration: number,
    decimals: number,
    prefix: string,
    suffix: string,
  ) {
    const start = performance.now();
    const tick = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const current = target * easeOutCubic(progress);
      el.textContent = formatCount(current, decimals, prefix, suffix);
      if (progress < 1) requestAnimationFrame(tick);
      else el.textContent = formatCount(target, decimals, prefix, suffix);
    };
    requestAnimationFrame(tick);
  }

  let highlightObserver: IntersectionObserver | null = null;

  function initHighlightShowcase() {
    highlightObserver?.disconnect();
    highlightObserver = null;

    const slides = document.querySelectorAll<HTMLElement>('[data-highlight-slide]');
    if (slides.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const activateSlide = (slide: HTMLElement) => {
      if (slide.dataset.animated === 'true') return;
      slide.dataset.animated = 'true';
      slide.classList.add('is-active');

      const countEl = slide.querySelector<HTMLElement>('[data-count-value]');
      if (!countEl) return;

      const target = Number(countEl.dataset.countValue);
      const prefix = countEl.dataset.countPrefix ?? '';
      const suffix = countEl.dataset.countSuffix ?? '';
      const decimals = Number(countEl.dataset.countDecimals ?? 0);

      if (reducedMotion || Number.isNaN(target)) {
        countEl.textContent = formatCount(target, decimals, prefix, suffix);
        return;
      }

      animateCount(countEl, target, 1200, decimals, prefix, suffix);
    };

    if (reducedMotion) {
      slides.forEach((slide) => activateSlide(slide));
      return;
    }

    highlightObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.target instanceof HTMLElement) {
            activateSlide(entry.target);
          }
        });
      },
      { threshold: 0.4 },
    );

    slides.forEach((slide) => highlightObserver!.observe(slide));
  }

  initHighlightShowcase();
  document.addEventListener('astro:page-load', initHighlightShowcase);
</script>
