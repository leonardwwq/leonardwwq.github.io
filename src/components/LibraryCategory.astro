---
import LibraryEntryDownloadLink from './LibraryEntryDownloadLink.astro';
import type { LibraryCategoryId } from '../data/library';
import { LIBRARY_DEFAULT_VISIBLE, type LibraryEntry } from '../data/library';

type Props = {
  categoryId: LibraryCategoryId;
  title: string;
  entries: LibraryEntry[];
};

const { categoryId, title, entries } = Astro.props;

const visible = entries.slice(0, LIBRARY_DEFAULT_VISIBLE);
const archive = entries.slice(LIBRARY_DEFAULT_VISIBLE);
const hasArchive = archive.length > 0;

function formatUpdated(iso: string) {
  const [y, m, d] = iso.split('-');
  if (!y || !m || !d) return iso;
  return `${y}-${m}-${d}`;
}

function thoughtParagraphs(text: string) {
  return text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
}

function hasDisplayYear(year: LibraryEntry['year']): boolean {
  if (year === undefined) return false;
  if (typeof year === 'number' && !Number.isNaN(year)) return true;
  const s = String(year).trim();
  return Boolean(s && s !== '—' && s !== '-' && s !== '–' && s !== '未知');
}
---

<section class="library-category" data-library-category data-category-id={categoryId}>
  <div class="library-category__head">
    <h2>{title}</h2>
    {
      hasArchive ? (
        <button
          type="button"
          class="library-category__more"
          data-library-more
          aria-expanded="false"
        >
          展开更早（{archive.length}）
        </button>
      ) : null
    }
  </div>

  <div class="library-entries" data-library-accordion>
    {
      visible.map((entry, index) => (
        <article
          class:list={['library-entry', { 'is-open': index === 0 }]}
          data-library-entry
          id={`${categoryId}-${entry.id}`}
        >
          <div class="library-entry__header">
            <button
              type="button"
              class="library-entry__toggle"
              data-library-entry-toggle
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`${categoryId}-${entry.id}-body`}
            >
              <span class="library-entry__toggle-icon" aria-hidden="true" />
              <span class="sr-only">{index === 0 ? '收起' : '展开'}</span>
            </button>
            <div class="library-entry__meta">
              <span class="library-entry__title">{entry.title}</span>
              <span class="library-entry__sep" aria-hidden="true">
                ·
              </span>
              <span class="library-entry__author">{entry.author}</span>
              {hasDisplayYear(entry.year) ? (
                <>
                  <span class="library-entry__sep" aria-hidden="true">
                    ·
                  </span>
                  <span class="library-entry__year">{entry.year}</span>
                </>
              ) : null}
              {entry.featured ? <span class="library-entry__badge">精选</span> : null}
            </div>
            <time class="library-entry__updated" datetime={entry.updatedAt}>
              更新 {formatUpdated(entry.updatedAt)}
            </time>
          </div>
          {entry.link ? (
            <p class="library-entry__link-row">
              <LibraryEntryDownloadLink href={entry.link.href} label={entry.link.label} />
            </p>
          ) : null}
          <div
            class="library-entry__body"
            id={`${categoryId}-${entry.id}-body`}
            data-library-entry-body
          >
            <div class="library-entry__thoughts prose">
              {thoughtParagraphs(entry.thoughts).map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </div>
        </article>
      ))
    }

    {
      hasArchive ? (
        <div class="library-entries__archive" data-library-archive>
          {archive.map((entry) => (
            <article
              class="library-entry"
              data-library-entry
              id={`${categoryId}-${entry.id}`}
            >
              <div class="library-entry__header">
                <button
                  type="button"
                  class="library-entry__toggle"
                  data-library-entry-toggle
                  aria-expanded="false"
                  aria-controls={`${categoryId}-${entry.id}-body`}
                >
                  <span class="library-entry__toggle-icon" aria-hidden="true" />
                  <span class="sr-only">展开</span>
                </button>
                <div class="library-entry__meta">
                  <span class="library-entry__title">{entry.title}</span>
                  <span class="library-entry__sep" aria-hidden="true">
                    ·
                  </span>
                  <span class="library-entry__author">{entry.author}</span>
                  {hasDisplayYear(entry.year) ? (
                    <>
                      <span class="library-entry__sep" aria-hidden="true">
                        ·
                      </span>
                      <span class="library-entry__year">{entry.year}</span>
                    </>
                  ) : null}
                  {entry.featured ? <span class="library-entry__badge">精选</span> : null}
                </div>
                <time class="library-entry__updated" datetime={entry.updatedAt}>
                  更新 {formatUpdated(entry.updatedAt)}
                </time>
              </div>
              {entry.link ? (
                <p class="library-entry__link-row">
                  <LibraryEntryDownloadLink href={entry.link.href} label={entry.link.label} />
                </p>
              ) : null}
              <div
                class="library-entry__body"
                id={`${categoryId}-${entry.id}-body`}
                data-library-entry-body
              >
                <div class="library-entry__thoughts prose">
                  {thoughtParagraphs(entry.thoughts).map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : null
    }
  </div>
</section>
