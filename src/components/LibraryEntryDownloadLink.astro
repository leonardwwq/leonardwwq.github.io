---
type Props = {
  href: string;
  label?: string;
};

const { href, label } = Astro.props;
const text = label ?? '下载材料';
---

<a class="library-entry__download-link" href={href} target="_blank" rel="noopener noreferrer">
  <svg
    class="library-entry__download-icon"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
    <polyline points="7 10 12 15 17 10"></polyline>
    <line x1="12" x2="12" y1="15" y2="3"></line>
  </svg>
  <span>{text}</span>
</a>
