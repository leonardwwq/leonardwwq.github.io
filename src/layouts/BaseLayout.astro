---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
};

const { title, description = '产品经理作品集：作品、资料库与关于我。' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于我' },
  { href: '/work', label: '作品' },
  { href: '/library', label: '资料库' },
  { href: '/contact', label: '联系与简历' },
];

function isCurrent(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/" transition:animate="fade">
          王伟权 <small>作品集</small>
        </a>
        <nav class="nav" aria-label="主导航">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div class="row">
        <span>© {new Date().getFullYear()} 王伟权</span>
        <span>
          <a href="/contact">联系与简历</a>
          ·
          <a href="/profile/202605-第三版-王伟权-产品经理.pdf" target="_blank" rel="noopener"
            >下载简历 PDF</a
          >
        </span>
      </div>
    </footer>
  </body>
</html>
