---
import BaseLayout from '../layouts/BaseLayout.astro';
import HighlightShowcase from '../components/HighlightShowcase.astro';
import { profile } from '../data/profile';

const { positioning, trajectory, approach } = profile.background;
---

<BaseLayout title="关于我 · 王伟权" description="背景、方向、方法论与能力标签。">
  <h1 class="page-title">关于我</h1>
  <blockquote class="blockquote">{profile.tagline}</blockquote>
  <p class="page-sub">
    {profile.role} · {profile.location} · {profile.status}
  </p>

  <div class="panel prose">
    <h2 class="section-title" style="margin-top: 0">背景与方向</h2>
    <p>{positioning}</p>
    <p>{trajectory}</p>
    <p>{approach}</p>
  </div>

  <h2 class="section-title">教育经历</h2>
  <div class="panel">
    <ul class="education-list">
      {profile.education.map((item) => (
        <li class="education-item">
          <div class="education-item__head">
            <strong>{item.school}</strong>
            <span class="muted education-item__period">{item.period}</span>
          </div>
          <p class="education-item__degree">{item.degree}</p>
          {item.note ? <p class="muted education-item__note">{item.note}</p> : null}
        </li>
      ))}
    </ul>
  </div>

  <h2 class="highlight-section-title">
    <span class="highlight-section-title__line" aria-hidden="true"></span>
    <span class="highlight-section-title__text">职业高光</span>
    <span class="highlight-section-title__line" aria-hidden="true"></span>
  </h2>
  <HighlightShowcase highlights={profile.highlights} />

  <h2 class="section-title">能力呈现</h2>
  <div class="panel">
    <p class="muted" style="margin-top: 0">擅长场景</p>
    <div class="tag-row">
      {profile.skills.scenarios.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
    <p class="muted" style="margin: 1rem 0 0">工作方式</p>
    <div class="tag-row">
      {profile.skills.methods.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
    <p class="muted" style="margin: 1rem 0 0">常用工具</p>
    <div class="tag-row">
      {profile.skills.tools.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .highlight-section-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.15rem;
    margin: 2.75rem 0 1.25rem;
    font-size: clamp(1.2rem, 2.8vw, 1.55rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-transform: none;
  }

  .highlight-section-title__text {
    flex-shrink: 0;
    color: var(--muted);
    opacity: 0.95;
  }

  .highlight-section-title__line {
    flex: 0 1 4.5rem;
    width: 4.5rem;
    max-width: 18vw;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--border-strong) 20%,
      var(--border-strong) 80%,
      transparent
    );
  }

  .education-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education-item + .education-item {
    margin-top: 1.15rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--border);
  }

  .education-item__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }

  .education-item__period {
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .education-item__degree {
    margin: 0.35rem 0 0;
    color: var(--text);
  }

  .education-item__note {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>
