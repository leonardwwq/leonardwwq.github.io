---
import BaseLayout from '../layouts/BaseLayout.astro';
import HighlightShowcase from '../components/HighlightShowcase.astro';
import { profile } from '../data/profile';

const { positioning, trajectory, approach } = profile.background;
---

<BaseLayout title="关于我 · 王伟权" description="背景、方向、方法论与能力标签。">
  <section class="content-section page-head">
    <p class="page-head__meta">个人档案</p>
    <h1 class="page-title">关于我</h1>
    <blockquote class="blockquote">{profile.tagline}</blockquote>
    <p class="page-sub">
      {profile.role} · {profile.location} · {profile.status}
    </p>
  </section>

  <div class="panel prose content-section">
    <h2 class="section-title section-title--flush">背景与方向</h2>
    <p>{positioning}</p>
    <p>{trajectory}</p>
    <p>{approach}</p>
  </div>

  <h2 class="section-title content-section">教育经历</h2>
  <div class="panel">
    <ul class="education-list">
      {profile.education.map((item) => (
        <li class="education-item">
          <div class="education-item__head">
            <strong>{item.school}</strong>
            <span class="muted education-item__period">{item.period}</span>
          </div>
          <p class="education-item__degree">{item.degree}</p>
          {item.note ? <p class="muted education-item__note">{item.note}</p> : null}
        </li>
      ))}
    </ul>
  </div>

  <h2 class="highlight-section-title content-section">
    <span class="highlight-section-title__line" aria-hidden="true"></span>
    <span class="highlight-section-title__text">职业高光</span>
    <span class="highlight-section-title__line" aria-hidden="true"></span>
  </h2>
  <HighlightShowcase highlights={profile.highlights} />

  <h2 class="section-title content-section">能力呈现</h2>
  <div class="panel">
    <p class="muted mt-0">擅长场景</p>
    <div class="tag-row">
      {profile.skills.scenarios.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
    <p class="muted mt-1">工作方式</p>
    <div class="tag-row">
      {profile.skills.methods.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
    <p class="muted mt-1">常用工具</p>
    <div class="tag-row">
      {profile.skills.tools.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .highlight-section-title {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
    margin: 2.4rem 0 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--faint);
    text-transform: uppercase;
  }

  .highlight-section-title__text {
    flex-shrink: 0;
    color: var(--faint);
    opacity: 1;
  }

  .highlight-section-title__line {
    flex: 1;
    width: auto;
    max-width: none;
    height: 1px;
    background: var(--border);
  }

  .education-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education-item + .education-item {
    margin-top: 1.15rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--border);
  }

  .education-item__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }

  .education-item__period {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .education-item__degree {
    margin: 0.35rem 0 0;
    color: var(--text);
  }

  .education-item__note {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>
