---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="关于我 · 王伟权" description="王伟权的工作背景与教育经历。">
  <section class="page-intro">
    <h1 class="page-title">关于我</h1>
    <p class="page-sub">我是{profile.name}，现居{profile.location}，目前{profile.status}。</p>
  </section>

  <section class="content-section prose about-background" aria-label="工作背景">
    <p>{profile.background.positioning}</p>
    <p>{profile.background.trajectory}</p>
  </section>

  <section class="content-section education" aria-labelledby="education-title">
    <h2 class="section-heading" id="education-title">教育经历</h2>
    <ul class="education-list">
      {profile.education.map((item) => (
        <li class="education-item">
          <div class="education-item__head">
            <h3>{item.school}</h3>
            <span class="muted education-item__period">{item.period}</span>
          </div>
          <p>{item.degree}</p>
        </li>
      ))}
    </ul>
  </section>

  <div class="content-section cta-row">
    <a class="btn" href="/work">看作品</a>
    <a class="btn btn-primary" href="/contact">联系我</a>
  </div>
</BaseLayout>

<style>
  .about-background,
  .education {
    max-width: 760px;
  }

  .education-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education-item {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .education-item:first-child {
    padding-top: 0.25rem;
  }

  .education-item__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }

  .education-item h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .education-item p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .education-item__period {
    font-size: 0.85rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
</style>
