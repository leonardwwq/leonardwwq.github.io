---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getActiveSocialLinks, profile } from '../data/profile';

const socialLinks = getActiveSocialLinks();
---

<BaseLayout title="联系我 · 王伟权" description="邮箱、手机与社交联系方式；页面内可下载简历（PDF）。">
  <section class="content-section page-head">
    <p class="page-head__meta">联系渠道</p>
    <h1 class="page-title">联系我</h1>
    <p class="page-sub">欢迎通过邮箱或手机联系；简历（PDF）见下方。</p>
  </section>

  <div class="panel prose content-section">
    <h2 class="section-title section-title--flush">联系方式</h2>
    <ul class="contact-list">
      <li>
        <span class="contact-list__label muted">邮箱</span>
        <a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
      </li>
      <li>
        <span class="contact-list__label muted">手机</span>
        <a href={`tel:${profile.contact.phone}`}>{profile.contact.phone}</a>
      </li>
      <li>
        <span class="contact-list__label muted">城市</span>
        <span>{profile.location}</span>
      </li>
    </ul>
  </div>

  {
    socialLinks.length > 0 ? (
      <div class="panel prose content-section">
        <h2 class="section-title section-title--flush">社交</h2>
        <ul class="social-list">
          {socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : null
  }

  <div class="panel content-section">
    <h2 class="section-title section-title--flush">简历（PDF）</h2>
    <p class="muted mt-0">与站点内固定路径一致，便于分享与更新文件名。</p>
    <div class="cta-row mt-075">
      <a class="btn btn-primary" href={profile.resumePath} target="_blank" rel="noopener">打开简历（PDF）</a>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-list,
  .social-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
  }

  .contact-list li + li {
    margin-top: 0.75rem;
  }

  .contact-list__label {
    min-width: 2.5rem;
  }

  .social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }
</style>
