---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getActiveSocialLinks, profile } from '../data/profile';

const socialLinks = getActiveSocialLinks();
---

<BaseLayout title="联系我 · 王伟权" description="通过邮箱、手机或 LinkedIn 联系王伟权。">
  <section class="page-intro">
    <h1 class="page-title">联系我</h1>
    <p class="page-sub">如果你想进一步了解作品，或聊聊工作机会，欢迎联系。</p>
  </section>

  <section class="content-section contact-details" aria-label="联系方式">
    <dl class="contact-list">
      <div>
        <dt class="muted">邮箱</dt>
        <dd><a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a></dd>
      </div>
      <div>
        <dt class="muted">手机</dt>
        <dd><a href={`tel:${profile.contact.phone}`}>{profile.contact.phone}</a></dd>
      </div>
      {socialLinks.map((link) => (
        <div>
          <dt class="muted">{link.label}</dt>
          <dd><a href={link.href} target="_blank" rel="noopener noreferrer">查看主页 ↗</a></dd>
        </div>
      ))}
    </dl>
    <p class="muted contact-location">目前在{profile.location}。</p>
  </section>
</BaseLayout>

<style>
  .contact-details {
    max-width: 760px;
  }

  .contact-list {
    margin: 0;
  }

  .contact-list > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.35rem 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .contact-list > div:first-child {
    padding-top: 0;
  }

  .contact-list dt {
    font-size: 0.9rem;
  }

  .contact-list dd {
    margin: 0;
    min-width: 0;
  }

  .contact-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-size: clamp(1rem, 2vw, 1.3rem);
    text-decoration-thickness: 1px;
  }

  .contact-location {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    .contact-list > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }
</style>
