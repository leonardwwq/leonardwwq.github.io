---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { featuredProjects, homeOtherSlugs } from '../data/portfolio';
import { workProjects, type WorkProject } from '../data/workProjects';

const otherProjects = homeOtherSlugs
  .map(slug => workProjects.find(project => project.slug === slug))
  .filter((project): project is WorkProject => Boolean(project));
---

<BaseLayout title="王伟权 · 作品集" description="做过的数据与业务平台，以及最近的 AI 产品探索。">
  <section class="home-intro" aria-labelledby="intro-title">
    <h1 id="intro-title">王伟权</h1>
    <p>过去主要做数据与业务平台，最近在做 AI 助手、工作台，以及持续互动的 AI 角色。</p>
    <a class="text-link" href="/contact">联系我 →</a>
  </section>

  <section id="selected" class="project-section" aria-labelledby="selected-title">
    <h2 class="section-heading" id="selected-title">精选作品</h2>
    {featuredProjects.map(project => <ProjectEntry project={project} featured />)}
  </section>

  <section class="project-section other-work-section" aria-labelledby="other-title">
    <div class="section-head">
      <h2 class="section-heading" id="other-title">其他作品</h2>
      <a class="text-link" href="/work">全部作品 →</a>
    </div>
    {otherProjects.map(project => <ProjectEntry project={project} />)}
  </section>
</BaseLayout>
