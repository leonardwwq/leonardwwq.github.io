---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpotlightProjectCard from '../components/SpotlightProjectCard.astro';
import { getHomeSpotlights } from '../data/spotlightProjects';
import { profile, resumePath } from '../data/profile';
---

<BaseLayout
  title="王伟权 · 作品集"
  description="王伟权的产品作品集：增长工具与数据平台案例、方法论与合作方式。聚焦从问题定义到结果交付。"
>
  <section class="hero content-section home-screen home-reveal home-reveal--1">
    <p class="eyebrow">产品经理作品集</p>
    <h1>把复杂增长问题，拆成可执行的产品闭环。</h1>
    <p class="lede">
      聚焦广告投放与增长场景，持续把「看数 - 判断 - 执行 - 复盘」做成可复用产品能力。
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/work" data-robot-topic="work">看我做过的项目</a>
      <a class="btn" href="/library" data-robot-topic="library">看我的方法论</a>
    </div>
  </section>

  <section class="content-section home-screen home-core-cases home-reveal home-reveal--2">
    <div class="home-section-head">
      <h2 class="home-section-title">我的核心案例</h2>
      <p class="home-section-note">先看这三个，就能快速判断我的问题定义、推进方式和结果导向。</p>
      <a class="shelf-action" href="/work" data-robot-topic="work">查看全部案例</a>
    </div>
    <div class="card-grid card-grid--compact">
      <a class="card" href="/work/ai-copilot-assistant" style="text-decoration: none; color: inherit" data-robot-topic="work-detail">
        <h3>AI Copilot 智能助手</h3>
        <p>基于MCP协议的上下文感知AI Agent产品，实现"AI建议→人工确认→自动执行"的人机协作闭环。</p>
        <div class="meta">
          <span class="tag">AI Agent</span>
          <span class="tag">MCP</span>
          <span class="tag">人机协同</span>
        </div>
      </a>
      <a class="card" href="/work/asa-smart-delivery" style="text-decoration: none; color: inherit" data-robot-topic="work-detail">
        <h3>ASA 智能投放平台</h3>
        <p>自建投放管理与数据分析一体化平台，显著提高投放效率。</p>
        <div class="meta">
          <span class="tag">广告投放系统</span>
          <span class="tag">智能投放</span>
        </div>
      </a>
      <a class="card" href="/work/bobo-weibo" style="text-decoration: none; color: inherit" data-robot-topic="work-detail">
        <h3>波波微博数据分析平台</h3>
        <p>从 0-1 商业化落地，运营期年均收入超过 100 万元。</p>
        <div class="meta">
          <span class="tag">0-1 产品</span>
          <span class="tag">商业化验证</span>
        </div>
      </a>
    </div>
  </section>

  {
    getHomeSpotlights().map((project) => (
      <section class="content-section home-spotlight home-screen home-reveal home-reveal--2b">
        <SpotlightProjectCard layout="banner" project={project} />
      </section>
    ))
  }

  <section class="content-section home-screen home-about home-reveal home-reveal--3">
    <div class="home-section-head">
      <h2 class="home-section-title">关于我</h2>
      <p class="home-section-note">从单平台 0-1 到多平台整合，我长期在增长与投放产品线上持续深耕。</p>
    </div>
    <p class="home-about-slogan">用数据丈量，用逻辑抽象，用规则决策，用心理加温。</p>
    <p class="home-about-desc">{profile.background.positioning}</p>
  </section>

  <section class="content-section home-screen home-knowledge home-reveal home-reveal--4">
    <div class="home-section-head">
      <h2 class="home-section-title">知识储备</h2>
      <p class="home-section-note">持续积累并交叉应用在产品实践中的三条主线。</p>
    </div>
    <ul class="home-knowledge-list">
      <li>
        <h3>人工智能</h3>
        <p>关注 LLM 在 B 端流程中的可控落地，强调“辅助决策”而非黑盒替代。</p>
      </li>
      <li>
        <h3>用户研究</h3>
        <p>结合行为数据与场景访谈，定位真实问题并指导功能优先级。</p>
      </li>
      <li>
        <h3>决策研究</h3>
        <p>把复杂判断拆成可解释、可追踪的决策路径，提升协同与复盘效率。</p>
      </li>
    </ul>
    <div class="cta-row">
      <a class="btn" href="/about" data-robot-topic="about">查看完整背景</a>
      <a class="btn" href={resumePath} target="_blank" rel="noopener" data-robot-topic="resume">下载简历</a>
    </div>
  </section>
</BaseLayout>
