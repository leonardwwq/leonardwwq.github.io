---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LibraryCategory from '../../components/LibraryCategory.astro';
import { getEntriesForCategory, libraryCategories } from '../../data/library';
---

<BaseLayout title="思考库 · 王伟权" description="按主题整理的阅读摘录与持续思考。">
  <section class="content-section">
    <h1 class="page-title">思考库</h1>
    <p class="page-sub">
      前三个主题为体系化阅读思考，默认展示前三条，可展开更早条目；同一分类同时只展开一条。文献笔记收录论文与报告的精读摘要，完整笔记通过外链打开。
    </p>
  </section>

  {
    libraryCategories.map((cat) => (
      <LibraryCategory
        categoryId={cat.id}
        title={cat.title}
        entries={getEntriesForCategory(cat.id)}
        layout={cat.id === 'literature' ? 'compact' : 'accordion'}
      />
    ))
  }
</BaseLayout>

