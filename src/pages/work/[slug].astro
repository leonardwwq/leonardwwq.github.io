---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseSection from '../../components/CaseSection.astro';
import '../../styles/case-editorial.css';
import { describeProject, orderedProjects, projectAliases, projectLinks } from '../../data/portfolio';
import { workProjects, type WorkProject } from '../../data/workProjects';

export function getStaticPaths() {
  // 历史 slug 仍生成跳转页，避免旧链接失效。
  return workProjects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}

type Props = { project: WorkProject };
const { project } = Astro.props;
const canonicalSlug = projectAliases[project.slug];
if (canonicalSlug) return Astro.redirect(`/work/${canonicalSlug}`, 301);

const editorial = project.slug === 'ai-copilot-assistant';
const info = describeProject(project);
const links = projectLinks(project);
const next = orderedProjects[(orderedProjects.findIndex(item => item.slug === project.slug) + 1) % orderedProjects.length];
const nextInfo = describeProject(next);
---

<BaseLayout title={`${info.title} · 王伟权`} description={info.summary}>
  <article class:list={{ 'case-editorial': editorial }}>
    <header class="case-head">
      <a class="breadcrumb" href="/work"><span aria-hidden="true">←</span> 全部作品</a>
      <h1 class="page-title">{info.title}</h1>
      <p class="case-summary">{info.summary}</p>
      <dl class="case-facts">
        <div><dt>项目状态</dt><dd>{info.status}</dd></div>
        {info.role && <div><dt>当时职责</dt><dd>{info.role}</dd></div>}
      </dl>
      {links.length > 0 && (
        <div class="project-entry-links case-actions">
          {links.map(link => (
            <a href={link.path} target="_blank" rel="noopener noreferrer">
              {link.label}<span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )}
      {info.note && <p class="case-note">{info.note}</p>}
      {project.demoPath && (
        <details class="embed-disclosure">
          <summary>站内预览 · {project.slug === 'prd-builder' ? '实际业务产出' : '交互原型'}</summary>
          <div class="embed">
            <iframe src={project.demoPath} title={project.iframeTitle} loading="lazy"></iframe>
          </div>
        </details>
      )}
    </header>

    {editorial && (
      <nav class="case-outline" aria-label="案例章节">
        {info.sections.map((section, index) => (
          <a href={index === 0 ? '#problem' : '#results'}>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{section.title}
          </a>
        ))}
      </nav>
    )}

    <div class="case-body">
      {info.sections.map((section, index) => <CaseSection section={section} index={index} editorial={editorial} />)}
    </div>

    <nav class="case-next" aria-label="继续看作品">
      <div><span>更多作品</span><a href="/work">返回作品列表 ←</a></div>
      <div><span>下一件</span><a href={`/work/${next.slug}`}>{nextInfo.title} ↗</a></div>
    </nav>
  </article>
</BaseLayout>
