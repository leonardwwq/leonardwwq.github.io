---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectEntry from '../../components/ProjectEntry.astro';
import { featuredProjects, featuredSlugs, orderedProjects } from '../../data/portfolio';

const remaining = orderedProjects.filter(project => !featuredSlugs.includes(project.slug));
---

<BaseLayout title="作品 · 王伟权" description="王伟权做过的业务平台、AI 应用、开源工具与交互原型。">
  <section class="page-intro" id="top">
    <h1 class="page-title">作品</h1>
    <p class="page-sub">一些做过的产品。可以直接打开演示、原型或源码，也可以阅读项目说明。</p>
  </section>

  <section class="project-section" aria-labelledby="selected-title">
    <h2 class="section-heading" id="selected-title">精选作品</h2>
    {featuredProjects.map(project => <ProjectEntry project={project} featured />)}
  </section>

  <section class="project-section other-work-section" aria-labelledby="archive-title">
    <h2 class="section-heading" id="archive-title">其他作品</h2>
    {remaining.map(project => <ProjectEntry project={project} />)}
  </section>
</BaseLayout>
